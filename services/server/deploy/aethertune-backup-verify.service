[Unit]
Description=Verify AetherTune server backups
After=aethertune-backup.service
Requires=aethertune-backup.service

[Service]
Type=oneshot
EnvironmentFile=/etc/aethertune/server.env
ExecStart=/usr/local/libexec/aethertune-verify-backups.sh /var/backups/aethertune
NoNewPrivileges=yes
LockPersonality=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectHome=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
ReadOnlyPaths=/var/backups/aethertune
RestrictAddressFamilies=AF_UNIX
RestrictSUIDSGID=yes
UMask=0077
